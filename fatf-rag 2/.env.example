# Copy to .env to override defaults. Everything runs locally — no API keys.
# You can usually leave this file untouched.

# --- Generation backend ---
# "hf"    -> open-source GPT-2 / Flan-T5 via transformers (default; just pip install)
# "ollama" -> local Llama via Ollama (better quality; needs the Ollama app)
LLM_BACKEND=hf

# For the "hf" backend, which open-source model to use: flan-t5 | gpt2
HF_MODEL=flan-t5

# For the "ollama" backend (only used when LLM_BACKEND=ollama):
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2

# --- Embeddings (local, no key required) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
